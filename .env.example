# =================================================================
# PRIVATE DOCS AI - ENVIRONMENT CONFIGURATION
# Copy this file to .env and configure your desired AI provider.
# NEVER commit your actual .env file or API keys to Git.
# =================================================================

# Application Mode
APP_ENV=development
APP_NAME="Private Docs AI"
DEBUG=true

# Server Settings
HOST=0.0.0.0
PORT=8000
API_PREFIX=/api
CORS_ORIGINS=http://localhost:5174,http://localhost:5173,http://localhost:3000,http://127.0.0.1:5174,http://127.0.0.1:5173,http://127.0.0.1:3000

# AI Provider Selection: "openai" | "gemini" | "ollama" | "fallback"
# Note: "fallback" provides grounded offline extraction & extractive RAG without needing any API key!
AI_PROVIDER=fallback

# OpenAI Settings (required if AI_PROVIDER=openai)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Google Gemini Settings (required if AI_PROVIDER=gemini)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# Ollama / Local LLM Settings (required if AI_PROVIDER=ollama)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2

# Embedding Configuration: "local" | "openai" | "gemini"
# "local" runs fast, free onnx/chroma local vector embeddings without cloud calls
EMBEDDING_PROVIDER=local
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
GEMINI_EMBEDDING_MODEL=text-embedding-004

# Storage & Database Paths
DATABASE_URL=sqlite:///./data/app.db
CHROMA_PATH=./data/chroma
UPLOAD_DIR=./data/uploads
EXPORT_DIR=./data/exports

# Document Ingestion & Chunking Parameters
MAX_FILE_SIZE_MB=25
CHUNK_SIZE_TOKENS=600
CHUNK_OVERLAP_TOKENS=100
TOP_K_RETRIEVAL=6
