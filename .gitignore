# ==========================================
# PRIVATE DOCS AI - GITIGNORE CONFIGURATION
# Protects private user documents, embeddings,
# and secret credentials from git commits.
# ==========================================

# Environment variables & secrets
.env
.env.local
.env.*.local
*.pem
*.key

# Python virtual environment & cache
.venv/
venv/
env/
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.coverage
htmlcov/
dist/
build/
*.egg-info/

# Private user data & storage (CRITICAL PRIVACY SAFEGUARD)
data/uploads/*
!data/uploads/.gitkeep
data/chroma/*
!data/chroma/.gitkeep
data/exports/*
!data/exports/.gitkeep
*.db
*.sqlite
*.sqlite3

# Node / Frontend
frontend/node_modules/
frontend/dist/
frontend/.vite/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# OS and IDE files
.DS_Store
Thumbs.db
*.swp
*.swo
.idea/
*.log
